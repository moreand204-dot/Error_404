# حطهم في Vercel → Project → Settings → Environment Variables (مش في الكود!)
TELEGRAM_BOT_TOKEN=            # توكن بوت تليجرام اللي هيبعتلك التنبيهات (من @BotFather)
TELEGRAM_CHAT_ID=              # ID الشات بتاعك (ابعت للبوت رسالة وبعدين افتح getUpdates)
# اختياري:
REQUIRE_VERIFIED=0             # 1 = مينفعش حد يحمّل القالب إلا لو إيميله متفعّل
TEMPLATE_USER_LIMIT=30         # أقصى تحميلات للمستخدم في الساعة
TEMPLATE_IP_LIMIT=60           # أقصى طلبات للـ IP في الساعة
