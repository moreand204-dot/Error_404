    },
    {
      "source": "/.svn/:path*",
      "destination": "/api/trap?p=/.svn/:path*"
    },
    {
      "source": "/.vercel/:path*",
      "destination": "/api/trap?p=/.vercel/:path*"
    },
    {
      "source": "/.well-known/security-backup/:path*",
      "destination": "/api/trap?p=/.well-known/security-backup/:path*"
    },
    {
      "source": "/backup/:path*",
      "destination": "/api/trap?p=/backup/:path*"
    },
    {
      "source": "/backups/:path*",
      "destination": "/api/trap?p=/backups/:path*"
    },
    {
      "source": "/private/:path*",
      "destination": "/api/trap?p=/private/:path*"
    },
    {
      "source": "/secret-admin/:path*",
      "destination": "/api/trap?p=/secret-admin/:path*"
    },
    {
      "source": "/cgi-bin/:path*",
      "destination": "/api/trap?p=/cgi-bin/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "/api/trap?p=/actuator/:path*"
    },
    {
      "source": "/manager/:path*",
      "destination": "/api/trap?p=/manager/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/trap?p=/api/admin/:path*"
    },
    {
      "source": "/api/internal/:path*",
      "destination": "/api/trap?p=/api/internal/:path*"
    },
    {
      "source": "/api/_private/:path*",
      "destination": "/api/trap?p=/api/_private/:path*"
    },
    {
      "source": "/node_modules/:path*",
      "destination": "/api/trap?p=/node_modules/:path*"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/api/trap?p=/vendor/:path*"
    },
    {
      "source": "/(.*)\\.(php|asp|aspx|jsp|cgi|sql|bak|old|swp|tar|gz|7z|rar|zip|log)",
      "destination": "/api/trap?p=/$1.$2"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/((?!api/|__/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://cdnjs.cloudflare.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com wss://*.firebaseio.com; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}