{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/template.js": {
      "includeFiles": "api/_private/**",
      "maxDuration": 15
    },
    "api/trap.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://love-ece13.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://love-ece13.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/admin",
      "destination": "/api/trap?p=/admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/trap?p=/admin/"
    },
    {
      "source": "/administrator",
      "destination": "/api/trap?p=/administrator"
    },
    {
      "source": "/admin.html",
      "destination": "/api/trap?p=/admin.html"
    },
    {
      "source": "/admin.php",
      "destination": "/api/trap?p=/admin.php"
    },
    {
      "source": "/admin-panel",
      "destination": "/api/trap?p=/admin-panel"
    },
    {
      "source": "/admin-login",
      "destination": "/api/trap?p=/admin-login"
    },
    {
      "source": "/adminpanel",
      "destination": "/api/trap?p=/adminpanel"
    },
    {
      "source": "/dashboard-admin",
      "destination": "/api/trap?p=/dashboard-admin"
    },
    {
      "source": "/secret-admin",
      "destination": "/api/trap?p=/secret-admin"
    },
    {
      "source": "/cpanel",
      "destination": "/api/trap?p=/cpanel"
    },
    {
      "source": "/login.php",
      "destination": "/api/trap?p=/login.php"
    },
    {
      "source": "/wp-login.php",
      "destination": "/api/trap?p=/wp-login.php"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/api/trap?p=/xmlrpc.php"
    },
    {
      "source": "/phpmyadmin",
      "destination": "/api/trap?p=/phpmyadmin"
    },
    {
      "source": "/pma",
      "destination": "/api/trap?p=/pma"
