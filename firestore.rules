rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- دوال مساعدة ----------
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['moreand458@gmail.com'];
    }

    function str(v, max) { return v is string && v.size() <= max; }

    // صورة البروفايل: فاضية، أو data:image صغيرة، أو رابط https بسيط
    function okPhoto(p) {
      return p is string && (
        p == ''
        || (p.size() <= 60000 && p.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))
        || (p.size() <= 600   && p.matches('https://[^ "\'()\\\\]+'))
      );
    }

    // ---------- المستخدمين ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','photo','provider','createdAt','lastLogin','loginCount'])
        && request.resource.data.keys().hasAll(['name','email','provider','createdAt','lastLogin','loginCount'])
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider in ['google','email']
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLogin == request.time
        && request.resource.data.loginCount == 1
        && okPhoto(request.resource.data.get('photo', ''));

      // المستخدم يقدر يغيّر بس: الاسم، الصورة، آخر دخول، عدد الدخول (+1)
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photo','lastLogin','loginCount'])
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && okPhoto(request.resource.data.get('photo', ''))
        && (request.resource.data.lastLogin == resource.data.lastLogin || request.resource.data.lastLogin == request.time)
        && (request.resource.data.loginCount == resource.data.loginCount || request.resource.data.loginCount == resource.data.loginCount + 1);

      allow delete: if isAdmin();
    }

    // ---------- نسخ البوتات ----------
    match /bots/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','number','devAr','devEn','devNumbers','channelName','channelId','channelLink','stickerPack','stickerAuthor','uid','ownerEmail','ownerName','downloads','createdAt'])
        && request.resource.data.keys().hasAll(['name','number','uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.downloads == 1
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.number, 15) && request.resource.data.number.matches('[0-9]{8,15}')
        && str(request.resource.data.get('devAr', ''), 200)
        && str(request.resource.data.get('devEn', ''), 200)
        && str(request.resource.data.get('devNumbers', ''), 200)
        && str(request.resource.data.get('channelName', ''), 100)
        && str(request.resource.data.get('channelId', ''), 60)
        && str(request.resource.data.get('channelLink', ''), 200)
        && str(request.resource.data.get('stickerPack', ''), 80)
        && str(request.resource.data.get('stickerAuthor', ''), 80)
        && str(request.resource.data.get('ownerName', ''), 60);

      // صاحب النسخة بس: يعدّل بياناتها أو يزوّد التحميلات +1. مستحيل يغيّر uid/ownerEmail/createdAt
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','number','devAr','devEn','devNumbers','channelName','channelId','channelLink','stickerPack','stickerAuthor','downloads'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.number, 15) && request.resource.data.number.matches('[0-9]{8,15}')
        && str(request.resource.data.get('devAr', ''), 200)
        && str(request.resource.data.get('devEn', ''), 200)
        && str(request.resource.data.get('devNumbers', ''), 200)
        && str(request.resource.data.get('channelName', ''), 100)
        && str(request.resource.data.get('channelId', ''), 60)
        && str(request.resource.data.get('channelLink', ''), 200)
        && str(request.resource.data.get('stickerPack', ''), 80)
        && str(request.resource.data.get('stickerAuthor', ''), 80)
        && (request.resource.data.downloads == resource.data.get('downloads', 0)
            || request.resource.data.downloads == resource.data.get('downloads', 0) + 1);

      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // أي حاجة تانية: ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
